# Server Port
PORT=3000
NODE_ENV=development

# Supabase Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key-48-characters
SUPABASE_SERVICE_KEY=your-service-role-key-48-characters
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-48-characters

# Google Gemini AI Key
GEMINI_API_KEY=your-gemini-api-key

# Google Geocoding API key for visit addresses. Not the Gemini key.
GOOGLE_MAPS_API_KEY=

# Approved WhatsApp Authentication template for visit codes.
WHATSAPP_VISIT_OTP_TEMPLATE=visit_verification_code

# Temporary. Set to true to show the visit code in the app instead of WhatsApp.
# Delete this after the Authentication template is live.
# VISIT_OTP_TEST_MODE=true

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@enlightmetals.com
SUPER_ADMIN_PASSWORD=your-super-admin-password

# Database (Prisma / Direct Connection)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Zoho Bigin CRM Credentials
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# Zoho Books test org. Leave Bigin credentials above unchanged.
# Use accounts.zoho.in and www.zohoapis.in for an India org.
# ZOHO_BOOKS_CLIENT_ID=
# ZOHO_BOOKS_CLIENT_SECRET=
# ZOHO_BOOKS_REFRESH_TOKEN=
# ZOHO_BOOKS_ORG_ID=
# ZOHO_BOOKS_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_BOOKS_API_BASE=https://www.zohoapis.in/books/v3
# ZOHO_BOOKS_ENABLED=true
# ZOHO_BOOKS_READ_ONLY=true

# Security & Tokens
JWT_SECRET=your-jwt-secret
